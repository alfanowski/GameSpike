__pycache__/
*.pyc
.venv/
# Runs write to checkpoints/{arm}_seed{seed}/, so these need the `**` (which also
# matches zero directories, i.e. still covers anything left directly in checkpoints/).
checkpoints/**/*.pt
checkpoints/**/*.json
checkpoints/**/*.jsonl
# checkpoints_init/ holds the untrained (--steps 0) reference checkpoints used as the
# experimental control -- regenerable from a fixed seed, so not worth distributing.
checkpoints_init/
*.gb
*.gbc
.pytest_cache/
.DS_Store

# Worktree metadata created by the agent harness, not project source.
.claude/worktrees/

# v2 (corrected) matrix. A SEPARATE --checkpoint-dir rather than --run-tag: the
# analysis path matches run directories with `^(?P<arm>[A-Za-z0-9]+)_seed(\d+)$`
# (analysis/aggregate_results.py) and eval outputs with an equally strict
# `eval_{arm}_seed{n}_{regime}.json`, so a `_v2` SUFFIX on the run directory would
# silently match nothing. Putting the tag in the PARENT directory keeps every run
# directory named exactly `{arm}_seed{n}` and needs no change to code that the v1
# results depend on for their reproducibility.
checkpoints_v2/**/*.pt
checkpoints_v2/**/*.json
checkpoints_v2/**/*.jsonl
checkpoints_v2_init/
checkpoints_v2/**/*.log
# Launcher stdout for the v2 matrix. Per-job detail lives in each run's
# launcher.log; these are the top-level driver logs, regenerable and noisy.
checkpoints_v2_*_launch.log
results_v2_eval.log
pipeline_v2.log

# Resonate-and-fire pilot (docs/EXPERIMENT_LOG.md §23). Same PARENT-directory
# tagging convention as the v2 block above, and for the same reason: every run
# directory has to stay named exactly `{arm}_seed{n}` or
# analysis/aggregate_results.py's anchored `^(?P<arm>[A-Za-z0-9]+)_seed(\d+)$`
# silently matches nothing, so the tag goes on the checkpoint-dir rather than into
# --run-tag. Checkpoints are 292 MB per arm and reproducible from a seed.
#
# results_rf_pilot/ is deliberately NOT ignored: evaluation JSONs are committed in
# this project (see results_v2/), because they are small and they are the only
# artifact a reader can check the published numbers against.
checkpoints_rf_pilot/**/*.pt
checkpoints_rf_pilot/**/*.json
checkpoints_rf_pilot/**/*.jsonl
checkpoints_rf_pilot/**/*.log
checkpoints_rf_pilot_init/
rf_pilot_*.log

# Preserved wreckage of the 23:38:53 power loss (docs/EXPERIMENT_LOG.md §18): the
# v2 reservoir runs as they stood at ~95.7% when the machine died. Kept rather
# than deleted so the restarted arm's logs can be diffed against them over the
# overlapping updates, which is a third independent check of §2's determinism
# property. 292 MB and regenerable from a seed, so not distributed.
checkpoints_v2_crashed/

# Phase 2a (docs/DESIGN_ROADMAP_PHASE2.md §15). Same reasoning as the v2 block
# above: a separate --checkpoint-dir rather than a --run-tag suffix, so every run
# directory keeps the exact name run_dir_for produces and no analysis path has to
# learn a new spelling. Checkpoints and per-run logs are regenerable from a seed
# and not worth distributing; the evaluation JSONs under results_p2a/ ARE
# committed, exactly as Phase 1's results/ and results_v2/ trees are.
checkpoints_p2a/**/*.pt
checkpoints_p2a/**/*.json
checkpoints_p2a/**/*.jsonl
checkpoints_p2a/**/*.log
checkpoints_p2a_init/
# Top-level driver logs for the Phase 2a pipeline: regenerable and noisy, with the
# per-job detail living in each run's own launcher.log.
phase2a_pipeline.log
phase2a_pipeline.out
# The training-matrix launcher's own lock directory -- runtime state, never source.
.run_training_matrix.lock/
